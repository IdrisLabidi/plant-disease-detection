          "password": { "type": "string", "minLength": 10, "title": "Password" },
          "display_name": {
            "anyOf": [{ "type": "string", "maxLength": 120 }, { "type": "null" }],
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": ["email", "password"],
        "title": "RegisterRequest"
      },
      "ScanResponse": {
        "properties": {
          "id": { "type": "string", "format": "uuid", "title": "Id" },
          "client_id": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Client Id"
          },
          "created_at": { "type": "string", "format": "date-time", "title": "Created At" },
          "source": { "type": "string", "title": "Source" },
          "model_name": { "type": "string", "title": "Model Name" },
          "model_version": { "type": "string", "title": "Model Version" },
          "top_class": { "type": "string", "title": "Top Class" },
          "confidence": { "type": "number", "title": "Confidence" },
          "top3": {
            "anyOf": [
              { "items": { "$ref": "#/components/schemas/TopPrediction" }, "type": "array" },
              { "items": {}, "type": "array" }
            ],
            "title": "Top3"
          },
          "unsure": { "type": "boolean", "title": "Unsure" },
          "lesion_area_frac": {
            "anyOf": [{ "type": "number" }, { "type": "null" }],
            "title": "Lesion Area Frac"
          },
          "mask_url": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Mask Url" },
          "latency_ms": {
            "anyOf": [{ "type": "integer" }, { "type": "null" }],
            "title": "Latency Ms"
          },
          "notes": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Notes" }
        },
        "type": "object",
        "required": [
          "id",
          "client_id",
          "created_at",
          "source",
          "model_name",
          "model_version",
          "top_class",
          "confidence",
          "top3",
          "unsure",
          "lesion_area_frac",
          "latency_ms",
          "notes"
        ],
        "title": "ScanResponse"
      },
      "TokenRequest": {
        "properties": { "token": { "type": "string", "minLength": 20, "title": "Token" } },
        "type": "object",
        "required": ["token"],
        "title": "TokenRequest"
      },
      "TokenResponse": {
        "properties": {
          "access_token": { "type": "string", "title": "Access Token" },
          "refresh_token": { "type": "string", "title": "Refresh Token" },
          "token_type": { "type": "string", "title": "Token Type", "default": "bearer" },
          "expires_in": { "type": "integer", "title": "Expires In" },
          "user": { "$ref": "#/components/schemas/UserResponse" },
          "is_new_user": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }],
            "title": "Is New User"
          }
        },
        "type": "object",
        "required": ["access_token", "refresh_token", "expires_in", "user"],
        "title": "TokenResponse"
      },
      "TopPrediction": {
        "properties": {
          "class_name": { "type": "string", "title": "Class Name" },
